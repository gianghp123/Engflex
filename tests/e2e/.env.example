# E2E env template — copy to .env (gitignored) and fill in the secrets.
# tests/e2e/.env wins; apps/web/.env.local is only a fallback for values
# left unset here. Shell env always wins over both.
#
# Dedicated e2e database, never the dev one (ensure-e2e-db.mjs creates +
# migrates it before the API boots).
DATABASE_URL=postgres://postgres:postgres@localhost:5777/engflex_e2e?sslmode=disable
# Same Clerk instance as the apps (also accepted as CLERK_PUBLISHABLE_KEY).
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required).
CLERK_SECRET_KEY=
# Pre-created test user (…+clerk_test@… suffix). Nothing else works without it.
E2E_CLERK_USER_EMAIL=
