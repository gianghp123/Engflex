# Copy to .env for local dev. Real environment variables always win over .env.
# Server
PORT=8000
APP_ENV=development

# Database (must match docker-compose.yaml via ${DB_*})
DB_HOST=localhost
DB_PORT=5777
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=engflex
DB_SSLMODE=disable

# Used by `make migration-up/migration-down` (goose)
DATABASE_URL=postgres://postgres:postgres@localhost:5777/engflex?sslmode=disable

# Auth (required — server refuses to start without it)
CLERK_SECRET_KEY=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5199

# Logging (level: debug|info|warn|error; format: text|json, default text in development)
LOG_LEVEL=info
LOG_FORMAT=text

# Sentry error monitoring (empty DSN = disabled; dev/CI run without it)
SENTRY_DSN=
# Event environment override (defaults to APP_ENV)
# SENTRY_ENVIRONMENT=development
# Fraction of requests traced, 0.0-1.0 (default 0 = errors only)
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DEBUG=false

# Voice engine (Python/Pipecat)
VOICE_SERVICE_URL=http://localhost:7860
VOICE_INTERNAL_SECRET=dev-internal-secret
VOICE_MAX_DURATION_SEC=300
VOICE_START_TIMEOUT_MS=15000
VOICE_OFFER_TIMEOUT_MS=10000

# LLM scoring (OpenAI-compatible chat endpoint for text-only scoring;
# required — server refuses to start without the key)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# Pronunciation scoring (OpenPronounce container; models are baked into the
# image, so the timeout covers a cold first request after a container start)
PRONOUNCE_SERVICE_URL=http://localhost:8001
PRONOUNCE_TIMEOUT_MS=120000

# Rate limiting (ulule/limiter formatted rates "<limit>-<period>", S/M/H/D)
# Budgets: a worked lesson is ~8-20 global requests over minutes; a 10-turn
# voice session is ~25 session-limited requests. Global covers a NAT-shared
# classroom; session caps LLM/engine spend per IP while fitting any human
# session. Dev HMR reload bursts (~4/mount) stay far under both.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=300-M
RATE_LIMIT_SESSION=30-M
# Comma-separated CIDRs trusted for X-Forwarded-For (limiter keys on ClientIP).
# The web server now proxies every API call and forwards the browser's IP
# (apps/web/src/lib/api.server.ts), so list the web host here — without it
# every user shares one bucket and the global budget collapses. Empty trusts
# none: correct for dev, where loopback is the only peer. Behind a platform
# LB of your own, include its CIDR as well.
RATE_LIMIT_TRUSTED_PROXIES=

# Redis (shared connection for rate limiting and future features;
# empty REDIS_URL = in-memory store, single-replica dev/CI)
REDIS_URL=redis://localhost:6379/
REDIS_PORT=6379
REDIS_KEY_PREFIX=engflex

# Lesson media (MinIO in dev). Audio URLs are same-origin relative paths
# served by the web app's /api/media route, so no base URL is configured.
MINIO_ROOT_USER=engflex
MINIO_ROOT_PASSWORD=engflex-dev-secret
# Host ports for the MinIO API/console mappings. If you change MINIO_PORT,
# update MINIO_ENDPOINT to match.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9010
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=lesson-audio
