{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "videos": {
    "hub": {
      "title": "Video library",
      "body": "Watch the video and practice listening sentence by sentence.",
      "empty": {
        "title": "No videos yet",
        "body": "The video library is being stocked. Check back soon."
      },
      "loading": "Loading video library"
    },
    "section": {
      "count": "({count} lessons)",
      "seeAll": "See all"
    },
    "card": {
      "pro": "PRO",
      "views": "{count} listens",
      "duration": "Duration {time}",
      "source": {
        "youtube": "Youtube"
      },
      "practice": {
        "dictation": "Dictation",
        "shadowing": "Shadowing",
        "done": "{mode}: completed",
        "todo": "{mode}: not practiced yet"
      }
    },
    "modeDialog": {
      "title": "Choose a practice mode",
      "body": "Pick the mode that suits you best",
      "mode": {
        "dictation": "Listen & write",
        "shadowing": "Shadow the speaker"
      }
    },
    "dictation": {
      "toolbar": {
        "hideMedia": "Hide media",
        "showMedia": "Show media",
        "hideTranscript": "Hide transcript",
        "showTranscript": "Show transcript"
      },
      "video": {
        "title": "Video",
        "time": "Time {time}",
        "controls": "Controls",
        "start": "Start",
        "replay": "Replay"
      },
      "level": {
        "label": "Difficulty",
        "easy": "Easy",
        "normal": "Normal",
        "hard": "Hard"
      },
      "hints": {
        "reveal": "Reveal word {index}",
        "hide": "Hide word {index}",
        "note": "Revealed words count as mistakes and lower your score.",
        "revealAll": "Reveal all words"
      },
      "next": "Next",
      "summary": {
        "title": "Session Completed",
        "body": "You have completed all sentences in this video.",
        "accuracy": "Accuracy: {percent}%",
        "correctWords": "Correct words: {count}",
        "incorrectWords": "Incorrect words: {count}",
        "restart": "Practice Again",
        "backToHub": "Back to Videos"
      },
      "empty": {
        "title": "No Transcript Available",
        "body": "This video does not have subtitles available for dictation practice.",
        "back": "Back to Videos"
      },
      "input": {
        "hint": "Type each word and press Space to check",
        "sentenceDone": "Sentence completed! Press Enter or 'Next' to continue.",
        "accuracy": "{correct}/{total} words correct"
      }
    },
    "practice": {
      "video": {
        "play": "Play video"
      },
      "player": {
        "prev": "Previous sentence",
        "replay": "Replay sentence",
        "play": "Play sentence",
        "next": "Next sentence",
        "speed": "Playback speed {speed}x",
        "settings": "Settings",
        "shortcuts": "Keyboard shortcuts"
      },
      "transcript": {
        "title": "Transcript",
        "progress": "{value}%",
        "item": "Sentence {index}",
        "edit": "Edit sentence"
      }
    },
    "shadowing": {
      "toolbar": {
        "hideTranscript": "Hide transcript",
        "showTranscript": "Show transcript",
        "view": "View mode",
        "watch": "Watch",
        "practice": "Practice",
        "time": "Time {time}"
      },
      "controls": {
        "autoPause": "Auto pause",
        "largeVideo": "Large video",
        "start": "Start"
      },
      "record": {
        "start": "Record",
        "stop": "Stop recording",
        "playback": "Play recording"
      },
      "transcript": {
        "phonetic": "IPA",
        "translation": "Translation"
      }
    },
    "category": {
      "back": "Back to topics",
      "total": "Total lessons: {count}",
      "filter": {
        "title": "Filters",
        "search": "Search lessons...",
        "level": "Difficulty",
        "levelAll": "All levels"
      },
      "empty": {
        "title": "No videos found",
        "body": "Try another keyword or difficulty."
      }
    }
  }
}
