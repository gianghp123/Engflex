{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "dashboard": {
    "hero": {
      "greeting": "Good morning",
      "greetingName": "Good morning, {name}",
      "subtitle": "Speech performance"
    },
    "activeLesson": {
