        },
        "spaced": {
          "kicker": "Spaced repetition",
          "title": "Word workout",
          "description": "Quick-fire recall that makes words stick.",
          "cta": "Practice"
        }
      }
    },
    "voicePartner": {
      "title": "Spontaneous speaking roleplay",
      "description": "Real-time conversational sparring with low latency speech recognition.",
      "selected": "Selected",
      "ready": "Ready",
      "start": "Start conversation"
    }
  }
