{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!**/src/paraglide"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": ["**/src/components/ui/sidebar.tsx"],
			"linter": {
				"rules": {
					"suspicious": { "noDocumentCookie": "off" },
					"correctness": { "useExhaustiveDependencies": "off" }
				}
			}
		},
		{
			"includes": ["**/src/components/ui/breadcrumb.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"useFocusableInteractive": "off",
						"useSemanticElements": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/components/ui/field.tsx"],
			"linter": {
				"rules": {
					"a11y": { "useSemanticElements": "off" },
					"suspicious": {
						"noDoubleEquals": "off",
						"noArrayIndexKey": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
