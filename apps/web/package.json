{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "srvx --prod -s dist/client dist/server/server.js --port 3000",
    "compile:messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check:conventions": "node scripts/check-conventions.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:live:headed": "playwright test --config playwright.live.config.ts --headed",
    "test:e2e:recovery": "playwright test --config playwright.recovery.config.ts",
    "test:e2e:recovery:headed": "playwright test --config playwright.recovery.config.ts --headed"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.21",
    "@engflex/contracts": "link:../../packages/contracts",
    "@faker-js/faker": "^10.3.0",
    "@pipecat-ai/client-js": "^1.13.1",
    "@pipecat-ai/client-react": "^1.8.2",
    "@pipecat-ai/small-webrtc-transport": "^1.10.8",
    "@pipecat-ai/voice-ui-kit": "^0.14.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "latest",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/store": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "srvx": "0.11.22",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@clerk/backend": "^3.20.1",
    "@clerk/testing": "^2.2.38",
    "@inlang/paraglide-js": "^2.13.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "pg": "^8.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
